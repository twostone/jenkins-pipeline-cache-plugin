<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="${%Cache Plugin}">
        <f:entry title="${%Credentials}" field="credentialsId" description="Select a stored 'username with password' credential (its username becomes the AWS access key ID, its password the secret access key) or a credential from the AWS Credentials plugin. Leave unset to use the fields below or the default AWS credential provider chain.">
            <f:select />
        </f:entry>

        <f:entry title="${%Username}" field="username" description="Explicit AWS access key ID. Ignored if a credential is selected above; if both username and password are blank, the default AWS credential provider chain (instance role, environment variables, etc.) is used.">
            <f:textbox />
        </f:entry>

        <f:entry title="${%Password}" field="password" description="Explicit AWS secret access key. Used only if no credential is selected above.">
            <f:password />
        </f:entry>

        <f:entry title="${%Bucket}" field="bucket">
            <f:textbox />
        </f:entry>

        <f:entry title="${%Region}" field="region">
            <f:textbox default="us-east-1" />
        </f:entry>

        <f:entry title="${%Endpoint}" field="endpoint" description="Optional. Only required for S3-compatible services (e.g. MinIO). Leave blank for native AWS S3.">
            <f:textbox default="https://s3.amazonaws.com" />
        </f:entry>

        <f:entry title="${%Threshold}" field="threshold">
            <f:textbox default="5000" />
        </f:entry>

        <f:validateButton title="Test connection" progress="Testing S3 connectivity..." method="testConnection"
                          with="credentialsId,username,password,bucket,region,endpoint"/>
    </f:section>
</j:jelly>
